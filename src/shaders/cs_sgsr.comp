// Snapdragon(tm) Game Super Resolution v1, ported from
// sgsr/v1/include/glsl/sgsr1_shader_mobile.frag in
// https://github.com/SnapdragonStudios/snapdragon-gsr to a gamescope
// compute pass. The algorithm body is verbatim upstream (OperationMode 1);
// only the I/O around it is ours: fragment coords become invocation ids,
// ViewportInfo derives from the bound textures, and the result lands in the
// intermediate image the blit pass composites from.

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

#define OperationMode 1
#define EdgeThreshold 8.0/255.0
#define EdgeSharpness 2.0

float fastLanczos2(float x)
{
	float wA = x-4.0;
	float wB = x*wA-wA;
	wA *= wA;
	return wB*wA;
}
vec2 weightY(float dx, float dy,float c, float std)
{
	float x = ((dx*dx)+(dy* dy))* 0.55 + clamp(abs(c)*std, 0.0, 1.0);
	float w = fastLanczos2(x);
	return vec2(w, w * c);
}

void main()
{
	uvec2 outCoord = gl_GlobalInvocationID.xy;
	uvec2 outSize = uvec2(imageSize(dst));
	if (outCoord.x >= outSize.x || outCoord.y >= outSize.y)
		return;

	ivec2 inSize = textureSize(s_samplers[0], 0);
	vec4 ViewportInfo0 = vec4(1.0/vec2(inSize), vec2(inSize));
	vec2 uv = (vec2(outCoord) + vec2(0.5)) / vec2(outSize);

	int mode = OperationMode;
	float edgeThreshold = EdgeThreshold;
	float edgeSharpness = EdgeSharpness;

	vec4 color;
	if(mode == 1)
		color.xyz = textureLod(s_samplers[0],uv,0.0).xyz;
	else
		color.xyzw = textureLod(s_samplers[0],uv,0.0).xyzw;

	if ( mode!=4)
	{
		highp vec2 imgCoord = ((uv*ViewportInfo0.zw)+vec2(-0.5,0.5));
		highp vec2 imgCoordPixel = floor(imgCoord);
		highp vec2 coord = (imgCoordPixel*ViewportInfo0.xy);
		vec2 pl = (imgCoord+(-imgCoordPixel));
		vec4  left = textureGather(s_samplers[0],coord, OperationMode);

		float edgeVote = abs(left.z - left.y) + abs(color[mode] - left.y)  + abs(color[mode] - left.z) ;
		if(edgeVote > edgeThreshold)
		{
			coord.x += ViewportInfo0.x;

			vec4 right = textureGather(s_samplers[0],coord + vec2(ViewportInfo0.x, 0.0), OperationMode);
			vec4 upDown;
			upDown.xy = textureGather(s_samplers[0],coord + vec2(0.0, -ViewportInfo0.y),OperationMode).wz;
			upDown.zw  = textureGather(s_samplers[0],coord+ vec2(0.0, ViewportInfo0.y), OperationMode).yx;

			float mean = (left.y+left.z+right.x+right.w)*0.25;
			left = left - vec4(mean);
			right = right - vec4(mean);
			upDown = upDown - vec4(mean);
			color.w =color[mode] - mean;

			float sum = (((((abs(left.x)+abs(left.y))+abs(left.z))+abs(left.w))+(((abs(right.x)+abs(right.y))+abs(right.z))+abs(right.w)))+(((abs(upDown.x)+abs(upDown.y))+abs(upDown.z))+abs(upDown.w)));
			float std = 2.181818/sum;

			vec2 aWY = weightY(pl.x, pl.y+1.0, upDown.x,std);
			aWY += weightY(pl.x-1.0, pl.y+1.0, upDown.y,std);
			aWY += weightY(pl.x-1.0, pl.y-2.0, upDown.z,std);
			aWY += weightY(pl.x, pl.y-2.0, upDown.w,std);
			aWY += weightY(pl.x+1.0, pl.y-1.0, left.x,std);
			aWY += weightY(pl.x, pl.y-1.0, left.y,std);
			aWY += weightY(pl.x, pl.y, left.z,std);
			aWY += weightY(pl.x+1.0, pl.y, left.w,std);
			aWY += weightY(pl.x-1.0, pl.y-1.0, right.x,std);
			aWY += weightY(pl.x-2.0, pl.y-1.0, right.y,std);
			aWY += weightY(pl.x-2.0, pl.y, right.z,std);
			aWY += weightY(pl.x-1.0, pl.y, right.w,std);

			float finalY = aWY.y/aWY.x;

			float maxY = max(max(left.y,left.z),max(right.x,right.w));
			float minY = min(min(left.y,left.z),min(right.x,right.w));
			finalY = clamp(edgeSharpness*finalY, minY, maxY);

			float deltaY = finalY -color.w;

			//smooth high contrast input
			deltaY = clamp(deltaY, -23.0 / 255.0, 23.0 / 255.0);

			color.x = clamp((color.x+deltaY),0.0,1.0);
			color.y = clamp((color.y+deltaY),0.0,1.0);
			color.z = clamp((color.z+deltaY),0.0,1.0);
		}
	}

	color.w = 1.0;  //assume alpha channel is not used
	imageStore(dst, ivec2(outCoord), color);
}
