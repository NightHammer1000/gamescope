// Anime4K v3.2 Upscale CNN x2 (S), from glsl/Upscale/Anime4K_Upscale_CNN_x2_S.glsl
// in https://github.com/bloc97/Anime4K, converted from mpv user-shader hooks to
// gamescope compute passes. The convolution weights are verbatim upstream.

#include "descriptor_set.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = ivec2(imageSize(dst));
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    // Depth to space: each source texel carries a 2x2 block of residuals in
    // its four channels; pick ours by output-pixel parity, then add it on top
    // of the bilinearly upscaled source (upstream: ... + MAIN_tex(MAIN_pos)).
    ivec2 i0 = ivec2(coord.x & 1, coord.y & 1);
    float c0 = texelFetch(s_samplers[0], coord >> 1, 0)[i0.y * 2 + i0.x];

    vec2 uv = (vec2(coord) + vec2(0.5)) / vec2(outSize);
    vec3 base = textureLod(s_samplers[1], uv, 0.0).rgb;

    vec3 color = clamp(base + vec3(c0), vec3(0.0), vec3(1.0));
    imageStore(dst, coord, vec4(color, 1.0));
}
